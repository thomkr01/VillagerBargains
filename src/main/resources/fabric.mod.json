{
  "schemaVersion": 1,
  "id": "villagerbargains",
  "version": "${version}",
  "name": "Villager Bargains",
  "description": "Pins the random part of villager trade prices to the cheapest (or most expensive) value vanilla can roll. Optionally, traded enchanted books always get their lowest or highest level. Nothing else about trading changes.",
  "authors": ["Thomas"],
  "contact": {
    "homepage": "https://github.com/thomkr01/VillagerBargains",
    "sources": "https://github.com/thomkr01/VillagerBargains",
    "issues": "https://github.com/thomkr01/VillagerBargains/issues"
  },
  "license": "MIT",
  "icon": "assets/villagerbargains/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["com.villagerbargains.VillagerBargains"],
    "modmenu": ["com.villagerbargains.client.ModMenuIntegration"]
  },
  "mixins": [
    "villagerbargains.mixins.json",
    "villagerbargains.rules.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": ["~26.2", "~26.3"],
    "java": ">=25"
  },
  "suggests": {
    "modmenu": "*"
  }
}
