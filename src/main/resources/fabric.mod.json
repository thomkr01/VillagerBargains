{
  "schemaVersion": 1,
  "id": "villagerbargains",
  "version": "${version}",
  "name": "Villager Bargains",
  "description": "Pins the random part of villager trade prices to the cheapest (or most expensive) value vanilla can roll. Nothing else about trading changes.",
  "authors": ["Tommy"],
  "contact": {
    "sources": "https://github.com/thomkr01/VillagerBargains",
    "issues": "https://github.com/thomkr01/VillagerBargains/issues"
  },
  "license": "MIT",
  "icon": "assets/villagerbargains/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["com.villagerbargains.VillagerBargains"],
    "modmenu": ["com.villagerbargains.client.ModMenuIntegration"]
  },
  "mixins": [
    "villagerbargains.mixins.json",
    "villagerbargains.version.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_dependency}",
    "java": ">=25"
  },
  "suggests": {
    "modmenu": "*"
  }
}
